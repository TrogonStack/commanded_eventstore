WITH lock AS (
  SELECT pg_try_advisory_lock(
    '"<%= schema %>".subscriptions'::regclass::oid::int,
    (CASE WHEN $1 > 2147483647 THEN mod($1, 2147483647) ELSE $1 END)::int
  ) AS acquired, pg_backend_pid() AS pid, COALESCE(
    NULLIF(current_setting('eventstore.session_id', true), ''),
    set_config('eventstore.session_id', md5(random()::text || clock_timestamp()::text), false)
  ) AS session_id
), lease AS (
  UPDATE "<%= schema %>".subscriptions
  SET lock_generation = lock_generation + 1
  WHERE subscription_id = $1 AND (SELECT acquired FROM lock)
  RETURNING lock_generation, last_seen
)
SELECT lock.acquired, lock.pid, lock.session_id, lease.lock_generation, lease.last_seen
FROM lock LEFT JOIN lease ON true;
