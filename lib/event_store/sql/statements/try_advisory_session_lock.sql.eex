SELECT pg_try_advisory_lock(
  '"<%= schema %>".subscriptions'::regclass::oid::int,
  (CASE WHEN $1 > 2147483647 THEN mod($1, 2147483647) ELSE $1 END)::int
), pg_backend_pid(), COALESCE(
  NULLIF(current_setting('eventstore.session_id', true), ''),
  set_config('eventstore.session_id', md5(random()::text || clock_timestamp()::text), false)
);
